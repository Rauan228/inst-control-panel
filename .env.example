# ============================================================
# .env — шаблон. Скопировать в .env и заполнить.
# ============================================================

# --- режим ---
REG_METHOD=web
HEADLESS=1
MAX_ACCOUNTS=0

# --- почта: catch-all домен + IMAP ---
EMAIL_DOMAIN=example.com
EMAIL_LOCAL_PREFIX=ig
EMAIL_LOCAL_STYLE=mixed
IMAP_HOST=mail.privateemail.com
IMAP_PORT=993
IMAP_SSL=1
IMAP_USER=mail@example.com
IMAP_PASS=change_me
IMAP_MAILBOX=INBOX
IMAP_TIMEOUT=180
IMAP_POLL_INTERVAL=4

# --- капча ---
CAPTCHA_PROVIDER=voidcaptcha
CAPTCHA_API_KEY=
VOIDCAPTCHA_HOST=https://api.voidcaptcha.com
EVERYINFRA_HOST=https://api.everyinfra.com
CAPTCHA_TIMEOUT=120

# --- прокси (sticky-эндпоинты, один на аккаунт) ---
PROXY=
PROXY_LIST=
PROXY_ROTATION_URL=
PROXY_ROTATE_SLEEP=10
PROXY_MAX_RETRIES=5
PROXY_STICKY_HOURS=24

# --- гео выхода ---
GEO_TIMEZONE=
GEO_LOCALE=
GEO_TIMEZONE_POOL=

# --- гейт «Confirm you're human» ---
ENABLE_GATE=1
GATE_TIMEOUT=1200
GATE_MAX_ROUNDS=8
CLOSE_BEFORE_COOLDOWN=1

# --- отлёжка и прогрев ---
COOLDOWN_MIN=600
COOLDOWN_MAX=900
WARM_VISITS=2
WARM_SECONDS_MIN=20
WARM_SECONDS_MAX=45
WARM_PAUSE_MIN=15
WARM_PAUSE_MAX=40

# --- трафик ---
BLOCK_MEDIA=1

# --- браузер ---
BROWSER_CHANNEL=chromium
MOBILE_MODE=0

# --- SMS ---
SMS_PROVIDER=manual
SMS_API_BASE=
SMS_API_KEY=
SMS_SERVICE_CODE=ig
SMS_COUNTRY=187
SMSPOOL_SERVICE=ig

# --- ручной номер (код в файл) ---
MANUAL_PHONE=
MANUAL_SMS_FILE=manual_sms.txt
MANUAL_COUNTRY=

# --- ретраи API-канала ---
API_MAX_ATTEMPTS=3

# --- траст ---
AVATARS_DIR=avatars
ENABLE_AVATAR=1
ENABLE_TRUST=1
TRUST_TARGETS=

# --- файлы ---
COOKIES_DIR=cookies
SUCCESS_FILE=success.txt
FAILED_FILE=failed.txt
LOG_FILE=autoreg.log
